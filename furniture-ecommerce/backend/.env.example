# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas connection string, or local mongodb://localhost:27017/furniture)
MONGO_URI=mongodb://localhost:27017/furniture-ecommerce

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d

# Frontend URL (for CORS + payment redirect links)
CLIENT_URL=http://localhost:5173

# SSLCommerz (Bangladesh payment gateway) - sandbox credentials from https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_LIVE=false

# Optional: Stripe (international cards) - alternative/additional gateway
STRIPE_SECRET_KEY=
